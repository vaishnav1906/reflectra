{
  "id": "/app/chat",
  "name": "Reflectra",
  "short_name": "Reflectra",
  "description": "A mirror for your mind.",
  "start_url": "/app/chat?mode=reflection",
  "scope": "/",
  "display": "standalone",
  "background_color": "#0b0a12",
  "theme_color": "#0b0a12",
  "categories": ["lifestyle", "health", "productivity"],
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "shortcuts": [
    { "name": "New conversation", "url": "/app/chat?mode=reflection", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Your week", "url": "/app/week", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "People", "url": "/app/people", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
