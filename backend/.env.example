# Copy to backend/.env and fill in real values. Never commit the real .env.

# --- Database (Supabase Postgres with pgvector) ---
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/postgres

# --- LLM ---
MISTRAL_API_KEY=your_mistral_api_key_here
# MISTRAL_MODEL=mistral-small-latest

# --- Auth (Supabase Auth) ---
# Project URL from Supabase > Project Settings > API
SUPABASE_URL=https://your-project-ref.supabase.co
# Only needed if the project still signs tokens with the legacy shared secret
# (Project Settings > API > JWT Settings). Projects using asymmetric signing keys
# are verified automatically via the JWKS endpoint.
SUPABASE_JWT_SECRET=
# Optional: lets "delete account" also delete the Supabase Auth user. Server-only secret.
SUPABASE_SERVICE_ROLE_KEY=
# Require a confirmed email before an account is created/linked (recommended).
AUTH_REQUIRE_VERIFIED_EMAIL=true

# --- CORS ---
# Comma-separated frontend origins allowed to call the API.
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173
